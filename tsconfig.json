{
  "preset": "ts-jest/presets/default-esm",
  "compilerOptions": {
    "outDir": "./dist",
    "pretty": true,
    "target": "es2019",
    "module": "ESNext",
    "sourceMap": true,
    "declaration": true,
    "importHelpers": true,
    "strict": true,
    "esModuleInterop": true,
    "lib": ["esnext", "DOM"],
    "types": ["node", "jest"]
  },
  "include": ["./src/lib/**/*"]
}
